                    inner ysep=10pt, text=white, text centered]

% ===========================================================================
% SECTION 6: LIST ENVIRONMENTS (COMPACT)
% =====================================================================================

% Standard LaTeX lists consume massive amounts of vertical space. 
% These "narrow" environments force all separation variables to 0 or 1pt,
% making them ideal for dense, multi-line bullet points in academic slides.

\newenvironment{narrow_itemize}{
\begin{itemize}
  \setlength{\itemsep}{1pt} 
  \setlength{\parskip}{0pt} 
  \setlength{\parsep}{0pt}  
}{\end{itemize}}

\newenvironment{narrow_enumerate}{
\begin{enumerate}
  \setlength{\itemsep}{1pt}
  \setlength{\parskip}{0pt}
  \setlength{\parsep}{0pt}
}{\end{enumerate}}

\newenvironment{narrow_description}{
\begin{description}
  \setlength{\itemsep}{1pt}
  \setlength{\parskip}{0pt}
  \setlength{\parsep}{0pt}
}{\end{description}}

% =====================================================================
% SECTION 7: BEAMER TEMPLATES & PROGRESS BAR LOGIC
% ==========================================================================

% Strip away standard Beamer navigation symbols to minimize visual clutter
\setbeamertemplate{navigation symbols}{}

% Define a perfectly safe text bullet that works inherently in pdfLaTeX
\newcommand{\itemBullet}{\textbullet}
\setbeamertemplate{itemize item}{\itemBullet}
\setbeamertemplate{itemize subitem}{\itemBullet}
\setbeamertemplate{itemize subsubitem}{\itemBullet}

% Enforce standard formatting for figure and table captions
\setbeamertemplate{caption label separator}{: }
\setbeamertemplate{caption}[numbered]

% --- PROGRESS BAR MATHEMATICS ---
% We enter \makeatletter mode so LaTeX understands commands containing '@'.
\makeatletter

\def\progressbar@sectionprogressbar{}
\def\progressbar@titleprogressbar{}

% Allocate counter variables to track slide numbers
\newcount\progressbar@tmpcounta 
\newcount\progressbar@tmpcountb 
% Allocate dimension variables to calculate physical width on the page
\newdimen\progressbar@pbht      
\newdimen\progressbar@pbwd      
\newdimen\progressbar@tmpdim    

% Hardcode the maximum width and height for the section-level progress bar
\progressbar@pbwd=22em
\progressbar@pbht=0.4pt

% Macro to render the large progress bar (typically on section divider frames)
\def\progressbar@sectionprogressbar{%
  {\usebeamercolor{palette primary}% Load mtheme primary palette
    \progressbar@tmpcounta=\insertframenumber 
    \progressbar@tmpcountb=\inserttotalframenumber 
    \progressbar@tmpdim=\progressbar@pbwd
    % Mathematical operation: Width = (Current Frame / Total Frames) * Max Width
    \divide\progressbar@tmpdim by 100
    \multiply\progressbar@tmpdim by \progressbar@tmpcounta
    \divide\progressbar@tmpdim by \progressbar@tmpcountb
    \multiply\progressbar@tmpdim by 100
    \fontsize{1em}{1em}\selectfont
    \makebox[\textwidth][c]{
      \begin{tikzpicture}[tight background]
        % Print the name of the section directly above the line
        \node[anchor=south west, fg, inner sep=0pt, text width=\progressbar@pbwd] at (0pt, 0pt) {\insertsectionHEAD};
        % Draw the empty background track of the progress bar
        \draw[anchor=west, fg!20, fill=fg!20, inner sep=0pt]
        (0, -1ex) rectangle ++ (\progressbar@pbwd, \progressbar@pbht);
        % Overlay the filled portion of the progress bar
        \draw[anchor=west, fg, fill=fg, inner sep=0pt]
        (0, -1ex) rectangle ++ (\progressbar@tmpdim, \progressbar@pbht);
      \end{tikzpicture}%
    }
  }
}

% Macro to render the thin horizontal progress bar directly under slide titles
\if@useTitleProgressBar
\def\progressbar@titleprogressbar{%
  % Calculate completion percentage based on the full paper width
  \progressbar@tmpcounta=\insertframenumber
  \progressbar@tmpcountb=\inserttotalframenumber
  \progressbar@tmpdim=\paperwidth
  \divide\progressbar@tmpdim by 100
  \multiply\progressbar@tmpdim by \progressbar@tmpcounta
  \divide\progressbar@tmpdim by \progressbar@tmpcountb
  \multiply\progressbar@tmpdim by 100
  {%
    \usebeamercolor{palette quaternary}% Load mtheme colors
    \usebeamercolor{alerted text}% Load mtheme alert colors
    \begin{tikzpicture}[tight background]
      % Draw the empty track across the top of the slide
      \draw[palette quaternary.fg, fill=palette quaternary.fg] (0, 0) rectangle ($(\paperwidth, 0.6pt) - (0.4pt, 0)$);
      % Fill the track proportionally in the alert color
      \draw[alerted text.fg, fill=alerted text.fg] (0, 0) rectangle (\progressbar@tmpdim, 0.6pt);
    \end{tikzpicture}%
  }%
}
\fi

% Utility macro to forcefully capitalize the section title string
\newcommand{\insertsectionHEAD}{%
  \expandafter\insertsectionHEADaux\insertsectionhead}
\newcommand{\insertsectionHEADaux}[3]{\textsc{{#3}}}

% --- SLIDE TITLE (FRAMETITLE) DEFINITION ---
\setbeamertemplate{frametitle}{%
\nointerlineskip % Strip all default Beamer vertical padding
% Create a rigid color box extending the full width of the screen
\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.3cm,rightskip=0.3cm,ht=2.5ex,dp=1.5ex]{frametitle}
\if@protectFrameTitle
  \usebeamerfont{frametitle}{\protect\insertframetitle}%
\else
  \usebeamerfont{frametitle}{\insertframetitle}%
\fi
\end{beamercolorbox}%
% Dynamically append the thin title progress bar below the box
\if@useTitleProgressBar
  \vspace{-.5em}
  \begin{beamercolorbox}[wd=\paperwidth,ht=1pt,dp=0pt]{frametitle}
    \progressbar@titleprogressbar
  \end{beamercolorbox}
\fi
\vspace{\@mtheme@voffset} % Reintroduce specific padding before the main slide text
}

% --- SLIDE FOOTER (FOOTLINE) DEFINITION ---
\setbeamertemplate{footline}
{%
% A simple color box aligned to the bottom right for slide numbering
\begin{beamercolorbox}[wd=\textwidth,ht=3ex,dp=3ex,leftskip=0.3cm,rightskip=0.3cm]{structure}%
  \hfill\usebeamerfont{page number in head/foot}% Align right
  \insertframenumber% Print slide number
\end{beamercolorbox}%
}

% Exit core LaTeX programming mode
\makeatother

% ===============================================================================
% SECTION 8: SEMANTIC MARKUP & DISPLAY ENVIRONMENTS
% ====================================================================

% \idea{text}: A semantic wrapper that applies no formatting. 
% It exists purely to pair logically with the \point{} command in the source code.
\newcommand{\idea}[1]{#1}

% \point{text}: Emphasizes the "punchline" of a slide.
% Uses the custom dimred color and italicization to draw the eye naturally.
%\newcommand{\point}[1]{\textcolor{dimred}{\textit{#1}}}
\newcommand{\point}[1]{\alert{\textit{#1}}}

% \plain{text}: Generates a totally bare slide (no headers/footers).
% It INTENTIONALLY always uses the dark primary color palette to create a high-contrast 
% break between visually dense slides. This remains unaffected by the [dark] or [teal] options.
\newcommand{\plain}[1]{%
  \begingroup
  \setbeamercolor{background canvas}{use=palette primary,bg=palette primary.fg}
  \begin{frame}[plain]{#1}
    \centering
    % Vertically centers the text and forces it to white
    \vfill\vspace{1em}\usebeamerfont{section title}\textcolor{white}{#1}\vfill
  \end{frame}
  \endgroup
}

% Beamer hook: Automatically add 0.5cm of spacing after every itemize block 
% to ensure text doesn't feel cramped.
\AddToHook{cmd/itemize/after}{%
  \addtolength{\itemsep}{0.5cm}%
}

% figcommentlist: An ultra-compact list environment explicitly designed 
% for placing multi-line annotations directly under a plot or figure.
\ifdefined\figcommentlist\else
  \newenvironment{figcommentlist}{%
    \begin{itemize}%
      \setlength{\itemsep}{2pt}%
      \setlength{\parsep}{2pt}%
      \setlength{\topsep}{2pt}%
      \setlength{\partopsep}{0pt}%
      \setlength{\leftmargin}{1.5em}%
    }{%
    \end{itemize}%
  }
\fi

%\plotslide[options]{filename}: A macro that consumes an entire slide with one image.
% It applies a 1.5-second fade-in transition (if supported by the PDF viewer) 
% to soften the visual impact of sudden bright graphs.
\newcommand{\plotslide}[2][]{%
  \begin{frame}[plain,#1] 
    \transfade[duration=1.5] 
    \centering
    \vspace*{\fill} 
    \includegraphics[width=0.9\textwidth,height=0.8\textheight,keepaspectratio]{#2}
    \vspace*{\fill} 
  \end{frame}
}

% \plotslidecomment[options]{filename}{comment1}{comment2}{comment3}{comment4}
% Renders a plot pushed slightly upward, leaving just enough room at the bottom
% for up to four dynamically rendered bullet points.
\newcommand{\plotslidecomment}[6][]{%
  \begin{frame}[plain,#1]
    \transfade[duration=1.5]
    \centering
    \vspace{0.2cm} % Top padding
    \includegraphics[width=0.9\textwidth,height=0.6\textheight,keepaspectratio]{#2}
    \vspace{0.1cm} % Gap between image and text
    \def\a{#3}\def\b{#4}\def\c{#5}\def\d{#6}% Store arguments to test for emptiness
    \ifx\a\empty\else{% Only render the list if the first comment actually exists
      \scriptsize%
      \begin{figcommentlist}
        \item #3%
        \ifx\b\empty\else\item #4\fi % Render comment 2 if populated
        \ifx\c\empty\else\item #5\fi % Render comment 3 if populated
        \ifx\d\empty\else\item #6\fi % Render comment 4 if populated
      \end{figcommentlist}%
    }\fi
    \vspace*{\fill}
  \end{frame}
}

% \slidemovie[options]{filename}{poster}{caption}: Embeds playable video files.
% Requires a static placeholder image (poster) to be clicked on during the presentation.
\newcommand{\slidemovie}[4][]{%
  \begin{frame}[plain]
    \transfade[duration=1.5]
    \centering
    \vspace*{\fill}
    \movie[#1]{% Initialize the multimedia player
      \includegraphics[width=0.9\textwidth,height=0.7\textheight,keepaspectratio]{#3}% Static image
    }{#2}% Video path
    \par\vspace{0.3cm}
    {\small #4} % Accompanying caption
    \vspace*{\fill}
  \end{frame}
}

% =========================================================================
% SECTION 9: CUSTOM TITLE PAGE LAYOUT
% ==================================================================================

% Enter core LaTeX programming mode
\makeatletter

% Override Beamer's \maketitle macro to force it onto a totally empty (plain) frame.
\def\maketitle{\ifbeamer@inframe\titlepage\else\frame[plain]{\titlepage}\fi}
\def\titlepage{\usebeamertemplate{title page}}

% Rebuild the actual layout structure of the title page from scratch
\setbeamertemplate{title page}
{
  \begin{minipage}[b][\paperheight]{\textwidth}
    \vspace*{\@mtheme@voffset}
    \vfill % Force the title block down toward the center of the page
    \ifx\inserttitle\@empty\else
    % Format the main title string
    {\raggedright\linespread{1.0}\usebeamerfont{title}\usebeamercolor[fg]{title}\scshape{\inserttitle}\par}
    \vspace*{0.5em}
    \fi
    \ifx\insertsubtitle\@empty\else
    % Format the subtitle string
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
    \vspace*{0.5em}
    \fi
    % Draw a thin dividing line using the alert color (typically orange/red)
    \begin{tikzpicture}\draw[alerted text.fg] (0, 0) -- (\textwidth, 0);\end{tikzpicture}%
    \vspace*{1em}
    \ifx\insertauthor\@empty\else
    % Format the author string below the dividing line
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
    \vspace*{0.25em}
    \fi
    \vfill % Consume the remaining vertical space at the bottom of the page
    \vspace*{\@mtheme@voffset}
  \end{minipage}
}
\makeatother

% Re-enable all modes before exiting the style file
\mode<all>
\endinput
