% Internal toggles for the progress bar rendering logic
\newif\if@useTitleProgressBar
\newif\if@protectFrameTitle
\@useTitleProgressBartrue  % The thin progress bar is ON by default
\@protectFrameTitlefalse   % Do not over-protect frametitle expansion

% Define the vertical offset used to push the main title down on the title page
\newlength{\@mtheme@voffset}
\setlength{\@mtheme@voffset}{2em}

% --- CUSTOM THEME COLORS ---
% dimred: A custom red designed specifically to reduce eye strain in darkened 
% presentation rooms. Standard red (1,0,0) is often too harsh.
\definecolor{dimred}{rgb}{0.85, 0.1, 0.1}

% TolColors: A scientifically derived color palette optimized for colorblind 
% accessibility in data plotting. 
\definecolor{TolColor1}{HTML}{332288}   % dark purple
\definecolor{TolColor2}{HTML}{6699CC}   % dark blue
\definecolor{TolColor3}{HTML}{88CCEE}   % light blue
\definecolor{TolColor4}{HTML}{44AA99}   % light green
\definecolor{TolColor5}{HTML}{117733}   % dark green
\definecolor{TolColor6}{HTML}{999933}   % dark brown
\definecolor{TolColor7}{HTML}{DDCC77}   % light brown
\definecolor{TolColor8}{HTML}{661100}   % dark red
\definecolor{TolColor9}{HTML}{CC6677}   % light red
\definecolor{TolColor10}{HTML}{AA4466}  % light pink
\definecolor{TolColor11}{HTML}{882255}  % dark pink
\definecolor{TolColor12}{HTML}{AA4499}  % light purple

% Grayscale definitions used for subtle citations and horizontal lines
\definecolor{light-gray}{gray}{0.35}
\definecolor{ultra-light-gray}{gray}{0.65}
\definecolor{beyond-ultra-light-gray}{gray}{0.85}

% --- TEXT COLOR MACROS ---
% These commands quickly wrap text in the grayscale colors defined above.
\newcommand{\grey}[1]{\textcolor{light-gray}{#1}}
\newcommand{\verygrey}[1]{\textcolor{ultra-light-gray}{#1}}
\newcommand{\supergrey}[1]{\textcolor{beyond-ultra-light-gray}{#1}}

% --- CITATION MACROS ---
% Specialized commands for rendering academic citations in various sizes.
\newcommand{\REFgrey}[1]{{\tiny{\it{\textcolor{light-gray}{[#1]}}}}\normalsize}
\newcommand{\REFverygrey}[1]{{\tiny{\it{\textcolor{ultra-light-gray}{[#1]}}}}\normalsize}
\newcommand{\Citep}[1]{{\footnotesize{\it{\textcolor{light-gray}{[#1]}}}}\normalsize}
\newcommand{\Cite}[1]{{\footnotesize{\it{\textcolor{light-gray}{#1}}}}\normalsize}
% myREF highlights self-citations in orange for emphasis
\newcommand{\myREF}[1]{{\ssmall{\textbf{\textcolor{orange}{\textit{[#1]}}}}\normalsize}}

% abstractline draws a subtle dotted separator line.
\newcommand{\abstractline}{\noindent\makebox[\linewidth]{\resizebox{0.8\linewidth}{1pt}{\textcolor{ultra-light-gray}{$\bullet$}}}}

% myrefs creates a dedicated block of references separated by the abstractline.
\newcommand{\myrefs}[1]{{\abstractline \\ \ssmall{\begin{spacing}{0.98}\textcolor{light-gray}{[#1]}\end{spacing}}\normalsize}}

% MyURL forces a URL to render in bold font for higher visibility.
\newcommand{\MyURL}[1]{\href{#1}{\textbf{#1}}}

% ==============================================================================
% SECTION 4: GLOBAL THEME APPLICATION (DARK / TEAL OVERRIDES)
