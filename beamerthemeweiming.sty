\tikzstyle{TitleBox} = [draw=black, fill=orange!80, very thick,
                         rectangle, rounded corners, inner sep=10pt,
                         inner ysep=10pt, text=white, text centered]

% note: An inverted version of TitleBox—white interior, orange border.
\tikzstyle{note} = [draw=orange, fill=white, very thick,
                    rectangle, rounded corners, inner sep=10pt,
                    inner ysep=10pt, text=black]

% box: A standard emphasis box featuring a red boundary over a light blue fill.
