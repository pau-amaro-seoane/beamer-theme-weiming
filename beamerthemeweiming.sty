\if@weiming@dark
  \setbeamercolor{background canvas}{bg=black}
  \setbeamercolor{normal text}{fg=white, bg=black}
  \setbeamercolor{frametitle}{bg=black, fg=white}
  \setbeamercolor{title}{fg=white}
  \setbeamercolor{subtitle}{fg=white}
  \setbeamercolor{author}{fg=white}
  \setbeamercolor{date}{fg=white}
  \setbeamercolor{institute}{fg=white}
  \setbeamercolor{itemize item}{fg=white}
  \setbeamercolor{itemize subitem}{fg=white}
  \setbeamercolor{itemize subsubitem}{fg=white}
  \setbeamercolor{item}{fg=white}
\fi

% If the user called \usepackage[teal]{beamerthemeweiming}, apply dark teal overrides.
% We utilize 'mDarkTeal' natively provided by the imported metropolis color palette.
\if@weiming@teal
  \setbeamercolor{background canvas}{bg=mDarkTeal}
  \setbeamercolor{normal text}{fg=white, bg=mDarkTeal}
  \setbeamercolor{frametitle}{bg=mDarkTeal, fg=white}
  \setbeamercolor{title}{fg=white}
  \setbeamercolor{subtitle}{fg=white}
  \setbeamercolor{author}{fg=white}
  \setbeamercolor{date}{fg=white}
  \setbeamercolor{institute}{fg=white}
  \setbeamercolor{itemize item}{fg=white}
  \setbeamercolor{itemize subitem}{fg=white}
  \setbeamercolor{itemize subsubitem}{fg=white}
  \setbeamercolor{item}{fg=white}
\fi

