% Announce the package to the LaTeX compiler so it can be loaded via \usepackage
\ProvidesPackage{beamerthemeweiming}

% Restrict the execution of this code to presentation mode only. 
% This prevents errors if someone compiles the document in 'article' mode.
\mode<presentation>

% ===================================================================================
% SECTION 1: OPTIONS DECLARATION (LIGHT / DARK / TEAL)
% ===================================================================================

% We define boolean (true/false) variables to track which color theme is requested.
\newif\if@weiming@dark
\newif\if@weiming@teal

% Set the default state of all custom background modes to false (which equals 'light' mode)
\@weiming@darkfalse
\@weiming@tealfalse

% Declare the 'light' option (Default behavior)
\DeclareOption{light}{
  \@weiming@darkfalse
  \@weiming@tealfalse
}

% Declare the 'dark' option (Pure black background, white ink)
\DeclareOption{dark}{
  \@weiming@darktrue
  \@weiming@tealfalse
}

% Declare the 'teal' option (Dark teal background, white ink)
\DeclareOption{teal}{
  \@weiming@darkfalse
  \@weiming@tealtrue
}

% Process all provided package options before loading the rest of the file.
% For example, \usepackage[teal]{beamerthemeweiming} will trigger \@weiming@tealtrue.
\ProcessOptions\relax

% ===================================================================================
% SECTION 2: CORE PACKAGE DEPENDENCIES & ROBUST TYPOGRAPHY
% ========================================================================

% xcolor: Required for defining exact HTML, RGB, and grayscale colors.
\RequirePackage{xcolor}

% graphicx: The standard package for including external images (PDF, PNG, JPEG).
\RequirePackage{graphicx}

% multimedia: Provided by Beamer to handle embedding external video files.
% Essential for the custom \slidemovie macro defined later in this file.
\RequirePackage{multimedia}

% tikz: The premier graphics drawing package for LaTeX. Used heavily here 
% to draw the progress bars, custom title boxes, and semantic shapes.
\RequirePackage{tikz}

% pgfplots: A high-quality data plotting package. Loaded here to ensure 
% compatibility with standard plotting color cycles.
\RequirePackage{pgfplots}

% tcolorbox: A modern package for drawing colored text boxes.
\RequirePackage{tcolorbox}

% setspace: Allows for fine-grained control over line spacing (e.g., in bibliographies).
\RequirePackage{setspace}

% moresize: Extends the default LaTeX font sizes to include \ssmall and \HUGE.
\RequirePackage{moresize}

% tikz libraries: We must preload these specific TikZ modules so we can calculate
% relative coordinates and draw backgrounds behind nodes.
\usetikzlibrary{backgrounds, calc, positioning}

% --- BASE PALETTE IMPORT ---
% We load ONLY the color theme from metropolis to adopt their highly readable 
% high-contrast palette (dark teal primary, light grey background).
\usecolortheme{metropolis}

% --- ROBUST CANTARELL FONT LOADING ---
% We strictly use standard LaTeX font encoding (T1) and Type-1 fonts to ensure
% this theme compiles flawlessly under both pdfLaTeX and XeLaTeX without 
% fontspec throwing "missing font weight" errors.
\RequirePackage[T1]{fontenc}
\RequirePackage[type1,default]{cantarell} 

% --- BEAMER FONT SIZE OVERRIDES ---
% Beamer has a habit of mixing serif and sans-serif sizes in math/text mode. 
% We manually enforce sizes across all major slide elements to keep the Cantarell 
% typography consistent and clean.
\setbeamerfont{title}{size=\Large} 
\setbeamerfont{author}{size=\small} 
\setbeamerfont{date}{size=\small} 
\setbeamerfont{section title}{size=\Large} 
\setbeamerfont{block title}{size=\normalsize} 
\setbeamerfont{subtitle}{size=\large} 
% Note: We intentionally avoid \scshape in frametitle to prevent pdfLaTeX warnings.
\setbeamerfont{frametitle}{size=\large} 
\setbeamerfont{caption}{size=\small} 
\setbeamerfont{page number in head/foot}{size=\scriptsize} 

% ======================================================================
% SECTION 3: COLOR DEFINITIONS & MACROS
